# Токен со страницы «Бот» в портале Discord. Без него процесс не стартует.
DISCORD_TOKEN=

HOUR_SHIFT=0

# PROBE=0 выключает опрос лобби и миров.
# Хост бота должен видеть отказ на закрытом порту. Домашний канал отвечает
# handshake даже на порт 1, там автосдвиг сам выключится.

# Страницы для Discord: http://АДРЕС:WEB_PORT/terms и /privacy
WEB_PORT=80
